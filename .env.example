# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Confirm model availability for your OpenAI project before deployment.
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Required only when Gemini is selected in the UI.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional. When set, API requests must include this password.
APP_ACCESS_PASSWORD=
